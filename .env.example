# هیچ کلیدی را در مرورگر یا چت قرار ندهید.
DATASET_PATH=dataset
DATA_STALE_DAYS=30
APP_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
COOKIE_SECURE=false
GISOO_API_KEY=
# Explicit choice only: gemini-3.8-live OR qwen3.8-omni-flash-realtime
GISOO_REALTIME_MODEL=
# Approved post-call extraction only; no model is selected.
CALL_EXTRACTION_MODE=boxapi_post_call
# Only after provider confirms exact transcription payload and required capabilities.
GISOO_PROTOCOL_VERIFIED=false
GISOO_TRANSCRIPTION_CONFIG='{"input_audio_transcription":{"model":"whisper-1"}}'
CALL_TIMEOUT_SECONDS=120
CALL_DEMO_ACCESS_TOKEN=


BOXAPI_API_KEY=
BOXAPI_MODEL=
BOXAPI_REASONING_EFFORT=none

